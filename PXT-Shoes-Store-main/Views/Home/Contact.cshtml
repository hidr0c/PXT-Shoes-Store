@{
    ViewBag.Title = "Liên Hệ";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <style>

        .contact-section {
            padding: 80px 0;
            background: linear-gradient(135deg, #f8f9fa, #e3e7eb);
            color: #333;
        }

        .contact-title {
            text-align: center;
            font-size: 2.8rem;
            margin-bottom: 40px;
            font-weight: bold;
            color: #444;
        }

        .contact-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        .info-box {
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            text-align: center;
        }

        /* Căn chỉnh contact form */
        .contact-form {
            background: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            /* Căn trái tiêu đề để thẳng hàng với info-box */
            .contact-form h3 {
                text-align: left;
                width: 100%;
                font-size: 2rem;
                margin-bottom: 20px;
            }

        /* Căn giữa form-group với kích thước hợp lý */
        .form-group {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        /* Làm cho input và textarea to hơn và đều nhau */
        .form-control {
            border-radius: 8px;
            padding: 14px;
            border: 1px solid #ccc;
            width: 150%; /* Rộng hơn */
            font-size: 1.5rem;
        }

        /* Điều chỉnh nút gửi */
        .submit-button {
            width: 90%; /* To hơn */
            padding: 14px;
            background: #007bff;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 1.2rem; /* To hơn */
            transition: 0.3s;
        }

            .submit-button:hover {
                background: #0056b3;
            }


    </style>
}

<section class="contact-section">
    <div class="container">
        <h2 class="contact-title">@ViewBag.Title</h2>

        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="info-box">
                    <h4>Thông Tin Liên Hệ</h4>
                    <p><i class="fas fa-map-marker-alt"></i> <strong>Địa chỉ:</strong> Quốc lộ 22, xã Tân Xuân, huyện Hóc Môn, TP.HCM</p>
                    <p><i class="fas fa-phone-alt"></i> <strong>Phone:</strong> <span class="phone">0935.123.456</span></p>
                </div>
                <div class="info-box">
                    <h4>Hỗ Trợ & Hợp Tác</h4>
                    <p><i class="fas fa-envelope"></i> <strong>Hỗ trợ khách hàng:</strong> <a href="mailto:Hotro@PXTShoesShop.vn" class="text-dark">Hotro@PXTShoesShop.vn</a></p>
                    <p><i class="fas fa-envelope"></i> <strong>Hợp tác kinh doanh:</strong> <a href="mailto:Hoptac@PXTShoesShop.vn" class="text-dark">Hoptac@PXTShoesShop.vn</a></p>
                </div>
            </div>

            <div class="col-md-6 contact-form">
                <h3 class="text-center">Liên Hệ Với Chúng Tôi</h3>
                <form action="@Url.Action("SubmitContact", "Home")" method="post">
                    <div class="form-group">
                        <input type="text" id="name" name="name" class="form-control" placeholder="Tên Của Bạn" required />
                    </div>
                    <div class="form-group">
                        <input type="email" id="email" name="email" class="form-control" placeholder="Địa Chỉ Email Của Bạn" required />
                    </div>
                    <div class="form-group">
                        <textarea id="message" name="message" class="form-control" rows="4" placeholder="Lời Nhắn Của Bạn" required></textarea>
                    </div>
                    <button type="submit" class="submit-button">Gửi Lời Nhắn</button>
                </form>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
